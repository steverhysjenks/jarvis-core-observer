# Jarvis Core v1.1.0 example configuration
# Copy to /etc/jarvis-core/jarvis.env and replace values for your environment.
# Never commit the real file.

HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-home-assistant-long-lived-token

OLLAMA_URL=http://127.0.0.1:11434
JUDGEMENT_MODEL=qwen3:4b-instruct-2507-q4_K_M-8k

# Jarvis proactive Observer
OBSERVER_MODE=shadow
OBSERVER_INTERVAL_SECONDS=60
GLOBAL_ANNOUNCEMENT_COOLDOWN_SECONDS=600

# Authentication for /request and /voice/repeat-last
JARVIS_CORE_API_KEY=replace-with-a-long-random-value

# Music Assistant native API
MUSIC_ASSISTANT_URL=http://music-assistant.local:8095
MUSIC_ASSISTANT_TOKEN=replace-with-music-assistant-token

# Repeat-last eligibility window
REPLAY_MAX_AGE_SECONDS=1800

# Native SparkyFitness; enable only after scoped keys and acceptance are ready.
NUTRITION_ENABLED=false
SPARKY_MCP_URL=http://192.168.0.26:3004/mcp
SPARKY_READ_TOKEN_FILE=/etc/jarvis-core/secrets/sparky-read.token
SPARKY_WRITE_TOKEN_FILE=/etc/jarvis-core/secrets/sparky-write.token
NUTRITION_MEALIE_TOKEN_FILE=/etc/jarvis-core/secrets/mealie-recipes.token
