[Unit]
Description=Jarvis Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
EnvironmentFile=/etc/jarvis-core/jarvis.env
WorkingDirectory=/opt/jarvis-core
ExecStart=/opt/jarvis-core/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jarvis-core

[Install]
WantedBy=multi-user.target
